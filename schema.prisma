datasource db {
    provider = "postgresql"
    url      = env("POSTGRES_CONNECTION_URL")
}

generator client {
    provider = "prisma-client-js"
}

model Users {
    id          String    @id @db.VarChar(40)
    displayName String    @map("display_name") @db.VarChar(100)
    userEmail   String    @map("user_email") @db.VarChar(100)
    password    String
    avatarUrl   String    @map("avatar_url") @db.VarChar(255)
    player      Players[]
    created     BigInt
    modified    BigInt

    @@map("tbl_users")
}

model Games {
    id            String             @id @db.VarChar(40)
    rounds        Int
    maxPlayers    Int                @map("max_players")
    gameCode      String             @map("game_code") @db.VarChar(20)
    difficulty    GameDifficultyType @default(EASY)
    minWordLength Int                @map("min_word_length")
    drawTime      Int                @map("draw_time")
    wordCount     Int                @map("word_count")
    status        GameStatus         @default(INIT)
    created       BigInt
    modified      BigInt

    @@map("tbl_game")
}

model Players {
    id            String @id @db.VarChar(40)
    userId        String @map("user_id") @db.VarChar(40)
    gameId        String @map("game_id") @db.VarChar(40)
    isGameCreator Int    @map("is_game_creator")
    status        Int    @default(1)
    score         Int    @default(0)
    created       BigInt
    user          Users  @relation(fields: [userId], references: [id])
    modified      BigInt

    @@map("tbl_player")
}

enum GameDifficultyType {
    EASY   @map("EASY")
    MEDIUM @map("MEDIUM")
    HARD   @map("HARD")

    @@map("difficulty_level")
}

enum GameStatus {
    INIT    @map("INIT")
    ONGOING @map("ONGOING")
    ENDED   @map("ENDED")

    @@map("gamestatustype")
}
